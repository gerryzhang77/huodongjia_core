# ========================================
# 生产环境
# ========================================
# 使用命令: npm run build
# 描述: 生产环境构建，连接线上 API
# ========================================

NODE_ENV=production

# Mock 模式控制
VITE_USE_MOCK=false

# 临时演示模式控制
# true: 展示临时演示活动（骨干大团建活动）
# false: 仅展示真实活动数据
VITE_DEMO_MODE=false

# 生产环境 API Base URL
# 使用同域 /api，由生产服务器 Nginx 转发
VITE_API_BASE_URL=
VITE_PRODUCTION_MODE=true

# 报名二维码使用的公网前端地址
VITE_PUBLIC_APP_URL=https://www.eventclub.cn/

# ========================================
# Apifox 配置（生产环境不使用）
# ========================================
# VITE_AUTH_MOCK_URL=
# VITE_EVENT_MOCK_URL=
# VITE_MATCHING_MOCK_URL=
# VITE_EMBEDDING_MOCK_URL=
# VITE_REGISTRATION_MOCK_URL=
# VITE_APIFOX_TOKEN=
